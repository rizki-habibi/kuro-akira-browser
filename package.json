{
  "name": "kuro-akira-browser",
  "version": "2.1.0",
  "description": "Kuro Akira - Browser Pribadi Cepat, Aman, dan Penuh Kendali",
  "main": "electron/main.js",
  "author": "Kuro Akira",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "set NODE_ENV=development && npx electron .",
    "electron:prod": "npx electron .",
    "dist": "npm run build && npx electron-builder --win --publish always",
    "dist:local": "npm run build && npx electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kuroak.browser",
    "productName": "Kuro Akira",
    "icon": "public/icons/icon.png",
    "publish": {
      "provider": "github",
      "owner": "kuro-akira",
      "repo": "kuro-akira-browser"
    },
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "filters/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerLanguages": [
        "id"
      ]
    }
  }
}
