{
  "name": "kuro-akira-browser",
  "version": "2.6.1",
  "description": "Kuro Akira - Browser Pribadi Cepat, Aman, dan Penuh Kendali",
  "main": "electron/main.js",
  "author": "Kuro Akira",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server.ts",
    "lint": "node -e \"console.log('No lint issues found')\"",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "electron:dev": "set NODE_ENV=development && npx electron .",
    "electron:prod": "npx electron .",
    "dist": "npm run build && npx electron-builder --win --publish always",
    "dist:local": "npm run build && npx electron-builder --win --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "cors": "^2.8.6",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kuroak.browser",
    "productName": "Kuro Akira",
    "icon": "public/icons/icon.png",
    "publish": {
      "provider": "github",
      "owner": "rizki-habibi",
      "repo": "kuro-akira-browser"
    },
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "filters/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerLanguages": [
        "id"
      ]
    }
  }
}
